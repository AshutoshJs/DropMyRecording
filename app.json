{
  "expo": {
    "name": "DropMyRecording",
    "slug": "dropmyrecording",
    "scheme": "dropmyrecording",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ashutosh.dropmyrecording",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["audio/*", "video/3gpp", "application/ogg", "application/octet-stream"],
          "androidMultiIntentFilters": ["audio/*", "video/3gpp", "application/ogg", "application/octet-stream"]
        }
      ]
    ]
  }
}
